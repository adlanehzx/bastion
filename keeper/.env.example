# HTTP endpoint of the chain where the vault lives (BSC testnet by default)
RPC_URL=https://bsc-testnet.example.com/your-key
CHAIN_ID=97
VAULT_ADDRESS=0x...

# Private key of the keeper wallet. It only needs a little BNB for gas: it can never
# withdraw from the vault. Leave empty and set DRY_RUN=true to simulate without sending.
KEEPER_PRIVATE_KEY=
DRY_RUN=false

POLL_INTERVAL_SECS=15
MAX_GAS_PRICE_GWEI=5

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RUST_LOG=info
